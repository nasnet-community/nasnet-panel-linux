# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  nasnet-panel Configuration                                                   ║
# ║  Run ./nasnet-tool.sh install to auto-generate this file via the wizard.    ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ─── DEPLOYMENT MODE ─────────────────────────────────────────────────────────

# How the app is deployed: "docker" or "systemd"
# Set by the wizard — affects how reconfigure/update work
DEPLOY_MODE=docker

# ─── REQUIRED: You must provide these ────────────────────────────────────────

# Enable/disable Telegram bot (set to true to enable Telegram bot)
TELEGRAM_ENABLED=false

# Telegram bot token from @BotFather (required when TELEGRAM_ENABLED=true)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Comma-separated Telegram user IDs for bot admins (required when TELEGRAM_ENABLED=true)
ADMIN_IDS=YOUR_TELEGRAM_ID

# Admin panel login credentials
ADMIN_USERNAME=admin
# Generate hash: htpasswd -nbBC 10 "" "your-password" | tr -d ':\n' | sed 's/$2y/$2a/'
ADMIN_PASSWORD_HASH=

# ─── AUTO-GENERATED: Wizard creates these ────────────────────────────────────

# JWT secret — must be at least 32 characters
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=

# Database password
# Generate: openssl rand -base64 24
DB_PASSWORD=postgres

# ─── DERIVED: Set automatically from domain/IP ──────────────────────────────

# Base URL for subscription links (e.g. https://example.com or http://1.2.3.4:9761)
APP_BASE_URL=

# Web panel URL (e.g. https://example.com or http://1.2.3.4:9761)
SUB_PANEL_URL=

# JWT cookie domain (e.g. example.com, or empty for IP mode)
JWT_COOKIE_DOMAIN=
# Set to true when using HTTPS (domain mode)
JWT_COOKIE_SECURE=false

# Enable ACME auto-certificate issuance (requires ACME_EMAIL)
# When false, no certificate is issued even if APP_BASE_URL is HTTPS
ACME_ENABLED=false

# ACME / Let's Encrypt — set to false for production domains
ACME_STAGING=false

# ─── PROMPTED IN DOMAIN MODE ────────────────────────────────────────────────

# Email for Let's Encrypt certificate notifications
ACME_EMAIL=

# ─── OPTIONAL: Manual TLS / Backup ─────────────────────────────────────────

# Manual TLS certificate (bypasses ACME when set)
# TLS_CERT_FILE=/path/to/cert.pem
# TLS_KEY_FILE=/path/to/key.pem

# Backup directory for database exports
# BACKUP_DIR=./data/backups

# ─── OPTIONAL: Xray settings ───────────────────────────────────────────────

# Xray API call timeout in seconds
# XRAY_API_TIMEOUT=5

# Default inbound tag (used for legacy single-inbound setups)
# XRAY_INBOUND_TAG=vmess-in

# ─── DEFAULTS: Usually no changes needed ─────────────────────────────────────

# Application
APP_ENV=production
APP_PORT=9761

# Database
# DB_DRIVER: "postgres" (default) or "sqlite"
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_NAME=nasnet_panel
DB_SSL_MODE=disable
# SQLite-only: path to database file (used when DB_DRIVER=sqlite)
# DB_PATH=./data/nasnet_panel.db

# Telegram bot mode: "polling" or "webhook"
BOT_MODE=polling
WEBHOOK_URL=

# Telegram SOCKS5 proxy (optional)
TELEGRAM_PROXY_ENABLED=false
TELEGRAM_PROXY_TYPE=socks5
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=1080
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=

# Logging
LOG_LEVEL=info
LOG_FORMAT=text

# ACME settings
# Docker: /app/data/acme (matches container mount). Systemd: $INSTALL_DIR/data/acme.
ACME_CACHE_DIR=/app/data/acme
ACME_AUTO_RENEW=true

# JWT token expiry
JWT_ACCESS_EXPIRY=60
JWT_REFRESH_EXPIRY=168

# Metrics endpoint
METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_USERNAME=
METRICS_PASSWORD=

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_TARGET=app:9761
PROMETHEUS_SCRAPE_INTERVAL=5s
PROMETHEUS_RETENTION=15d
