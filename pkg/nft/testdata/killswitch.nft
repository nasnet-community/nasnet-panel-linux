table inet nasnet
delete table inet nasnet
table inet nasnet {
	set doh_bootstrap {
		type ipv4_addr
		elements = { 1.1.1.1, 1.0.0.1, 8.8.8.8, 8.8.4.4 }
	}

	chain mangle_pre {
		type filter hook prerouting priority mangle; policy accept;
		iifname "enp1s0" ct state new ct mark set ct mark and 0xf0ffffff or 0x1000000
		iifname "enp2s0" ct state new ct mark set ct mark and 0xf0ffffff or 0x2000000
		ct mark != 0x0 meta mark set ct mark and 0xfffffff
	}

	chain filter_fwd {
		type filter hook forward priority filter; policy drop;

		# LAN isolation. Closes the hole where any host on the domestic
		# segment can add a route and reach the LAN directly — DNAT is not
		# the only way in.
		ct state established,related accept
		iifname "lan0" oifname { "enp1s0", "nasnet-wg0" } accept
		ct status dnat accept
	}

	chain killswitch_out {
		type filter hook output priority filter + 10; policy accept;

		# Nothing this box originates may leave the secondary uplink in the
		# clear. Everything accepted below is either the tunnel's own crypto
		# or link-scoped, so none of it can carry payload to the internet.
		oifname != "enp2s0" accept

		# Replies to flows that arrived here — an inbound VPN user over the
		# dish. An outbound flow's first packet never leaves, so it can
		# never become established through this.
		ct state established,related accept

		# The tunnel's own transport. This is the whole point.
		meta mark and 0xf000000 == 0x2000000 meta l4proto udp accept

		# Resolving the endpoint hostname needs a resolver, and the only
		# one reachable before the tunnel is up is out here. Fixed
		# addresses over DoH: an editable list would be an editable hole.
		meta mark and 0xf000000 == 0x2000000 tcp dport 443 ip daddr @doh_bootstrap accept

		# Link-scoped only: a lease, the gateway the health probe pings,
		# and the dish's own management address.
		udp sport 68 udp dport 67 accept
		ip daddr 100.64.0.1 accept
		ip daddr 192.168.100.0/24 accept
		drop
	}

	chain killswitch_fwd {
		type filter hook forward priority filter + 10; policy accept;

		# The same rule for traffic passing through: a LAN host must not
		# reach the internet over the raw uplink either.
		oifname != "enp2s0" accept
		ct state established,related accept
		ip daddr 192.168.100.0/24 accept
		drop
	}

	chain mangle_post {
		type filter hook postrouting priority mangle; policy accept;
		meta mark and 0xfffffff != 0x0 ct mark set meta mark and 0xfffffff
	}

	chain nat_post {
		type nat hook postrouting priority srcnat; policy accept;
		oifname { "enp1s0", "enp2s0", "nasnet-wg0" } masquerade
	}
}
