table inet nasnet
delete table inet nasnet
table inet nasnet {
	set ir_v4 {
		type ipv4_addr
		flags interval
		auto-merge
		elements = { 2.144.0.0/13, 5.22.0.0/17 }
	}
	set ir_v6 {
		type ipv6_addr
		flags interval
		auto-merge
		elements = { 2001:db8::/32 }
	}
	set ir_dom_v4 {
		type ipv4_addr
		flags timeout
		timeout 24h
	}
	set ir_dom_v6 {
		type ipv6_addr
		flags timeout
		timeout 24h
	}

	chain mangle_pre {
		type filter hook prerouting priority mangle; policy accept;
		iifname "enp1s0" ct state new ct mark set ct mark and 0xf0ffffff or 0x1000000
		iifname "enp2s0" ct state new ct mark set ct mark and 0xf0ffffff or 0x2000000
		ct mark != 0x0 meta mark set ct mark and 0xfffffff

		# LAN classification — kernel-only, so it survives an xray
		# restart. Two layers: geoip prefixes as the floor, then
		# dnsmasq-populated domain sets, then a foreign catch-all.
		iifname "lan0" ip daddr @ir_v4 meta mark set mark and 0xff00ffff or 0x10000
		iifname "lan0" ip daddr @ir_dom_v4 meta mark set mark and 0xff00ffff or 0x10000
		iifname "lan0" ip6 daddr @ir_v6 meta mark set mark and 0xff00ffff or 0x10000
		iifname "lan0" ip6 daddr @ir_dom_v6 meta mark set mark and 0xff00ffff or 0x10000
		iifname "lan0" meta mark and 0xff0000 == 0x0 meta mark set mark and 0xff00ffff or 0x20000
	}

	chain nat_pre {
		type nat hook prerouting priority dstnat; policy accept;

		# `fib daddr type local` means "addressed to this box", which is
		# exactly what a port forward is, and it survives a DHCP renewal.
		# Paired with iifname it also refuses to fire on transit traffic.
		fib daddr type local iifname "enp1s0" tcp dport 443 dnat ip to 10.77.0.5:443
		fib daddr type local iifname "enp2s0" tcp dport 443 dnat ip to 10.77.0.5:443
	}

	chain filter_in {
		type filter hook input priority filter; policy drop;

		ct state established,related accept
		iifname { "lo", "lan0", "enp3s0" } accept
		icmp type { echo-request, destination-unreachable, time-exceeded } \
			limit rate 10/second accept

		# Every accept below is RENDERED from the same rows that generate
		# the xray config and the port forwards. A hand-maintained port list
		# would silently kill somebody's VPN.
		# panel
		iifname "enp1s0" tcp dport 9761 accept
		# vless-tcp
		iifname { "enp1s0", "enp2s0" } tcp dport 443 accept
	}

	chain filter_fwd {
		type filter hook forward priority filter; policy drop;

		# LAN isolation. Closes the hole where any host on the domestic
		# segment can add a route and reach the LAN directly — DNAT is not
		# the only way in.
		ct state established,related accept
		iifname "lan0" oifname { "enp1s0", "enp2s0" } accept
		ct status dnat accept
	}

	chain mangle_post {
		type filter hook postrouting priority mangle; policy accept;
		meta mark and 0xfffffff != 0x0 ct mark set meta mark and 0xfffffff
	}

	chain nat_post {
		type nat hook postrouting priority srcnat; policy accept;
		oifname { "enp1s0", "enp2s0" } masquerade
	}
}
